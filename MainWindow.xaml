<Window x:Class="GiftDrafter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GiftDrafter"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="700">
    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <CollectionViewSource x:Key="PendingAssignGroup" Source="{Binding PendingAssignments}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Receiver"></PropertyGroupDescription>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>


        <!-- Styles -->

        <Style x:Key="GlobalFontSize" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="HeaderFont" BasedOn="{StaticResource GlobalFontSize}" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="ValidityStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource GlobalFontSize}">
            <Setter Property="TextElement.Foreground" Value="Black"/>
            <Setter Property="TextElement.Background" Value="#99DDFFDD"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsValid}" Value="False">
                    <Setter Property="Foreground" Value="DimGray"/>
                    <Setter Property="Background" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DraftingStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDrafting}" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Background" Value="PaleGreen"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeparatorStyle" TargetType="Separator">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="ButtonText" TargetType="TextBlock">
            <Setter Property="Margin" Value="5, 0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AlwaysFocusedStyle" TargetType="ListViewItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter 
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                HorizontalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CCEEFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BBD8FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#70C0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Templates -->

        <DataTemplate x:Key="PersonTemplate" DataType="{x:Type local:Person}">
            <TextBlock Text="{Binding Name}"
                       Style="{StaticResource ValidityStyle}"
                       />
        </DataTemplate>

        <DataTemplate x:Key="CategoryTemplate" DataType="{x:Type local:Category}">
            <TextBlock Text="{Binding Desc}"
                       Style="{StaticResource ValidityStyle}"/>
        </DataTemplate>

        <DataTemplate x:Key="DraftableAssignmentTemplate" DataType="{x:Type local:Assignment}">
            <Border HorizontalAlignment="Stretch"
                    Width="Auto"
                    BorderBrush="Gray"
                    Background="Transparent"
                    BorderThickness="1">
                <TextBlock Style="{StaticResource ValidityStyle}"
                           HorizontalAlignment="Stretch">
                    <Run Text="  "></Run>
                    <Run Text="{Binding Receiver, Mode=OneWay}" FontWeight="Normal"/>
                    <Run Text="&#x09; &lt;-"/>
                    <Run Text="{Binding Category, Mode=OneWay}" FontWeight="Normal"/>
                </TextBlock>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DraftedAssignmentTemplate" DataType="{x:Type local:Assignment}">
            <TextBlock Text="{Binding Display}"
                       Style="{StaticResource GlobalFontSize}"
                       HorizontalAlignment="Stretch">
                <TextBlock.InputBindings>
                    <MouseBinding
                        MouseAction="LeftDoubleClick"
                        Command="{Binding DataContext.UnDraftAssignmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
                </TextBlock.InputBindings>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="ParticipantPreDraftTemplate" DataType="{x:Type local:Participant}">
            <TextBlock Text="{Binding Person.Name}" Style="{StaticResource GlobalFontSize}"/>
        </DataTemplate>
        
        <DataTemplate x:Key="DraftRoundTemplate" DataType="{x:Type local:DraftRound}">
            <GroupBox>
                <GroupBox.Header>
                    <TextBlock FontWeight="Bold">
                        <Run Text="Round: "/><Run Text="{Binding RoundNumber, Mode=OneWay}"/>
                    </TextBlock>
                </GroupBox.Header>
                <ListView ItemsSource="{Binding Participants}"
                          ItemTemplate="{StaticResource ParticipantPreDraftTemplate}"
                          SelectedItem="{Binding CurrentParticipant}"
                          SelectionMode="Single"
                          ItemContainerStyle="{StaticResource AlwaysFocusedStyle}"
                          IsEnabled="{Binding IsActive}"/>
            </GroupBox>
        </DataTemplate>

        <DataTemplate x:Key="ParticipantPostDraftTemplate" DataType="{x:Type local:Participant}">
            <StackPanel Orientation="Vertical">
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="{Binding Person.Name}" Style="{StaticResource GlobalFontSize}"/>
                    </GroupBox.Header>
                    <ListView ItemsSource="{Binding Assignments}"
                              ItemTemplate="{StaticResource DraftedAssignmentTemplate}"/>
                </GroupBox>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StrictnessTemplate" DataType="{x:Type local:Strictness}">
            <TextBlock Text="{Binding DisplayName}"/>
        </DataTemplate>

    </Window.Resources>


    <!-- MAIN GRID -->


    <Grid d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel, IsDesignTimeCreatable=True}">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                   HorizontalAlignment="Stretch"
                   Height="22" Margin="10,5,10,0">

            <Button Command="{Binding OpenInputFileCommand}">
                <TextBlock Text="Choose File" Style="{StaticResource ButtonText}"/>
            </Button>

            <Grid>

                <!-- Draft Not Started Buttons -->

                <DockPanel Visibility="{Binding DraftNotStarted, Converter={StaticResource BoolToVis}}"
                           HorizontalAlignment="Stretch" LastChildFill="False">

                    <Separator Style="{StaticResource SeparatorStyle}"/>

                    <Button Command="{Binding GenerateSeedCommand}">
                        <TextBlock Text="Generate Seed" 
                                   Style="{StaticResource ButtonText}"/>
                    </Button>

                    <Separator Style="{StaticResource SeparatorStyle}"/>

                    <TextBlock Text="Seed:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Seed, Mode=TwoWay}"
                             Width="80" VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SetSeedCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Separator Style="{StaticResource SeparatorStyle}"/>

                    <TextBlock Text="Draft Rounds:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox Width="40"
                              ItemsSource="{Binding DraftRoundOptions}"
                              SelectedValue="{Binding DraftRounds}"/>

                    <Separator Style="{StaticResource SeparatorStyle}"/>

                    <TextBlock Text="Strictness:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox 
                              ItemsSource="{Binding StrictnessOptions}"
                              SelectedValue="{Binding SelectedStrictness}"
                              ItemTemplate="{StaticResource StrictnessTemplate}"/>

                    <Button DockPanel.Dock="Right"
                            Command="{Binding StartDraftCommand}">
                        <TextBlock Text="Start Draft" Style="{StaticResource ButtonText}"/>
                    </Button>

                </DockPanel>

                <!-- Draft Started Buttons -->

                <DockPanel Visibility="{Binding DraftStarted, Converter={StaticResource BoolToVis}}"
                       HorizontalAlignment="Stretch" LastChildFill="False">

                    <Button DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Command="{Binding DraftPairCommand}"
                        Visibility="{Binding DraftStarted, Converter={StaticResource BoolToVis}}"
                        IsEnabled="{Binding SelectedAssignment.IsValid}">
                        <TextBlock Text="Draft This Combo"  Style="{StaticResource ButtonText}"/>
                    </Button>

                    <Separator DockPanel.Dock="Right" Style="{StaticResource SeparatorStyle}"/>

                    <Button DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Visibility="{Binding DraftStarted, Converter={StaticResource BoolToVis}}"
                        Command="{Binding ChooseAtRandomCommand}">
                        <TextBlock Text="Pick Random" Style="{StaticResource ButtonText}"/>
                    </Button>

                </DockPanel>
            </Grid>
        </DockPanel>


        <!-- Lists -->


        <GroupBox Grid.Row="1" Grid.Column="0" Margin="5" >
            <GroupBox.Header>
                <TextBlock Text="Draft Order" Style="{StaticResource HeaderFont}"/>
            </GroupBox.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DraftOrder}"
                          ItemTemplate="{StaticResource DraftRoundTemplate}">
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
        
        <GridSplitter Grid.Row="2" Grid.Column="0" Height="2"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      ResizeDirection="Rows"
                      Margin="5,0"/>

        <GroupBox Grid.Row="3" Grid.Column="0" Margin="5,0,5,5">
            <GroupBox.Header>
                <TextBlock Text="Assignments" Style="{StaticResource HeaderFont}"/>
            </GroupBox.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Participants}"
                              ItemTemplate="{StaticResource ParticipantPostDraftTemplate}"/>
            </ScrollViewer>
        </GroupBox>

        <GroupBox Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Margin="5">
            <GroupBox.Header>
                <TextBlock Text="Available Assignments" Style="{StaticResource HeaderFont}"/>
            </GroupBox.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListView ItemsSource="{Binding Source={StaticResource PendingAssignGroup}}"
                          SelectedItem="{Binding SelectedAssignment}"
                          ItemTemplate="{StaticResource DraftableAssignmentTemplate}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource AlwaysFocusedStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate DataType="GroupItem">
                                    <Separator Background="Transparent"></Separator>
                                    <!-- <TextBlock Text="{Binding Name}"/> -->
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>
            </ScrollViewer>
        </GroupBox>

        <!-- Footer -->

        <Button Grid.Row="4" Grid.Column="0" Margin="10,0,10,10"
                Command="{Binding GenerateRemainingCommand}">
            <TextBlock Text="Generate Remaining Assignments" Style="{StaticResource ButtonText}"/>
        </Button>

        <Button Grid.Row="4" Grid.Column="1" Margin="10, 0,10,10"
                Command="{Binding SaveAssignmentsCommand}">
            <TextBlock Text="Save Assignments" Style="{StaticResource ButtonText}"/>
        </Button>
        
    </Grid>
</Window>
