<Window x:Class="GiftDrafter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GiftDrafter"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="700">
    <Window.Resources>

        <Style x:Key="GlobalFontSize" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="ValidityStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource GlobalFontSize}">
            <Setter Property="TextElement.Foreground" Value="Black"/>
            <Setter Property="TextElement.Background" Value="#AAEEFFEE"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsValid}" Value="False">
                    <Setter Property="Foreground" Value="DimGray"/>
                    <Setter Property="Background" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DraftingStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDrafting}" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Background" Value="PaleGreen"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PersonTemplate" DataType="{x:Type local:Person}">
            <TextBlock Text="{Binding Name}"
                       Style="{StaticResource ValidityStyle}"
                       />
        </DataTemplate>

        <DataTemplate x:Key="CategoryTemplate" DataType="{x:Type local:Category}">
            <TextBlock Text="{Binding Desc}"
                       Style="{StaticResource ValidityStyle}"/>
        </DataTemplate>

        <DataTemplate x:Key="DraftableAssignmentTemplate" DataType="{x:Type local:Assignment}">
            <Border HorizontalAlignment="Stretch"
                    Width="Auto"
                    BorderBrush="Gray"
                    Background="Transparent"
                    BorderThickness="1">
                <TextBlock Text="{Binding Display}"
                           Style="{StaticResource ValidityStyle}"
                           HorizontalAlignment="Stretch"
                           />
            </Border>
        </DataTemplate>
        
        <DataTemplate x:Key="DraftedAssignmentTemplate" DataType="{x:Type local:Assignment}">
                <TextBlock Text="{Binding Display}"
                           Style="{StaticResource GlobalFontSize}"
                           HorizontalAlignment="Stretch"
                           />
        </DataTemplate>

        <DataTemplate x:Key="ParticipantPreDraftTemplate" DataType="{x:Type local:Participant}">
            <TextBlock Text="{Binding Person.Name}" Style="{StaticResource GlobalFontSize}"
                       />
                       <!-- Style="{StaticResource DraftingStyle}" -->
        </DataTemplate>

        <DataTemplate x:Key="ParticipantPostDraftTemplate" DataType="{x:Type local:Participant}">
            <StackPanel Orientation="Vertical">
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="{Binding Person.Name}" Style="{StaticResource GlobalFontSize}"/>
                    </GroupBox.Header>
                    <ListBox ItemsSource="{Binding Assignments}"
                             ItemTemplate="{StaticResource DraftedAssignmentTemplate}"/>
                </GroupBox>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel, IsDesignTimeCreatable=True}">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Buttons -->

        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Height="25">
            <Button HorizontalAlignment="Left" Margin="10,2"
                    Command="{Binding OpenInputFileCommand}">
                <TextBlock Text="Choose File" VerticalAlignment="Center"/>
            </Button>

            <Button HorizontalAlignment="Left" Margin="10, 2"
                    Command="{Binding GenerateSeedCommand}">
                <TextBlock Text="Generate Seed" IsEnabled="{Binding DraftNotStarted}"
                           VerticalAlignment="Center"/>
            </Button>

            <TextBlock Text="Seed:" Margin="5,2" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Seed, Mode=TwoWay}"
                     Width="100" Margin="0,2"
                     IsEnabled="{Binding DraftNotStarted}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SetSeedCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <TextBlock Text="Draft Rounds:" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <ComboBox Margin="5,2" Width="50"
                      ItemsSource="{Binding DraftRoundOptions}"
                      SelectedValue="{Binding DraftRounds}"
                      IsEnabled="{Binding DraftNotStarted}"/>

            <Button DockPanel.Dock="Right"
                    HorizontalAlignment="Right" Margin="10,2"
                    Command="{Binding DraftPairCommand}"
                    IsEnabled="{Binding SelectedAssignment.IsValid}">
                <TextBlock Text="Draft This Combo" VerticalAlignment="Center"/>
            </Button>

        </DockPanel>

        <!-- Lists -->

        <GroupBox Grid.Row="1" Grid.Column="0" Margin="5" >
            <GroupBox.Header>
                <TextBlock Text="Draft Order" Style="{StaticResource GlobalFontSize}"/>
            </GroupBox.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListView ItemsSource="{Binding DraftOrder}"
                          ItemTemplate="{StaticResource ParticipantPreDraftTemplate}"
                          SelectedItem="{Binding DraftingParticipant, Mode=TwoWay}"
                          SelectionMode="Single"
                          >
                </ListView>
            </ScrollViewer>
        </GroupBox>

        <GroupBox Grid.Row="2" Grid.Column="0" Margin="5">
            <GroupBox.Header>
                <TextBlock Text="Assignments" Style="{StaticResource GlobalFontSize}"/>
            </GroupBox.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Participants}"
                              ItemTemplate="{StaticResource ParticipantPostDraftTemplate}"
                              />
            </ScrollViewer>
        </GroupBox>

        <GroupBox Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Margin="5">
            <GroupBox.Header>
                <TextBlock Text="Available Assignments" Style="{StaticResource GlobalFontSize}"/>
            </GroupBox.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListView ItemsSource="{Binding PendingAssignments}"
                          SelectedItem="{Binding SelectedAssignment, Mode=TwoWay}"
                          ItemTemplate="{StaticResource DraftableAssignmentTemplate}"
                          >
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </ScrollViewer>
        </GroupBox>

        <!-- <GroupBox Grid.Row="1" Grid.Column="1" Margin="10" > -->
        <!--     <GroupBox.Header> -->
        <!--         <TextBlock>People</TextBlock> -->
        <!--     </GroupBox.Header> -->
        <!--     <ListBox ItemsSource="{Binding People}" -->
        <!--              ItemTemplate="{StaticResource PersonTemplate}" -->
        <!--              SelectionMode="Single" -->
        <!--              SelectedItem="{Binding SelectedPerson, Mode=TwoWay}" -->
        <!--              /> -->
        <!-- </GroupBox> -->
        <!-- -->
        <!-- <GroupBox Grid.Row="2" Grid.Column="1" Margin="10" > -->
        <!--     <GroupBox.Header> -->
        <!--         <TextBlock>Categories</TextBlock> -->
        <!--     </GroupBox.Header> -->
        <!--     <ListBox ItemsSource="{Binding Categories}" -->
        <!--              ItemTemplate="{StaticResource CategoryTemplate}" -->
        <!--              SelectionMode="Single" -->
        <!--              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/> -->
        <!-- </GroupBox> -->

        <Button Grid.Row="3" Grid.Column="0" Margin="10,0,10,10"
                Command="{Binding GenerateRemainingCommand}">
            <TextBlock Text="Generate Remaining Assignments"/>
        </Button>

        <Button Grid.Row="3" Grid.Column="1" Margin="10, 0,10,10"
                Command="{Binding SaveAssignmentsCommand}">
            <TextBlock Text="Save Assignments"/>
        </Button>
    </Grid>
</Window>
